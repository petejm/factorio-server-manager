# Multi-stage build - no CGO required (pure Go SQLite)
# Stage 1: Build the Go binary
FROM golang:1.21-bookworm AS builder

# Install build dependencies (only need nodejs/npm for frontend)
RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy source code
COPY . .

# Build frontend
RUN npm install && npm run build

# Build backend - no CGO needed
WORKDIR /build/src
ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64

RUN go build -ldflags="-s -w" -o /build/factorio-server-manager .

# Stage 2: Runtime image
FROM ubuntu:22.04

ENV FACTORIO_VERSION=stable \
    RCON_PASS=""

VOLUME /opt/fsm-data /opt/factorio/saves /opt/factorio/mods /opt/factorio/config

EXPOSE 80/tcp 34197/udp

RUN apt-get update && apt-get install -y \
    curl \
    tar \
    xz-utils \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/fsm

# Copy built binary and frontend
COPY --from=builder /build/factorio-server-manager /opt/fsm/factorio-server-manager
COPY --from=builder /build/app /opt/fsm/app
COPY conf.json.example /opt/fsm/conf.json
COPY docker/entrypoint.sh /opt/entrypoint.sh

RUN chmod +x /opt/fsm/factorio-server-manager /opt/entrypoint.sh

ENTRYPOINT ["/opt/entrypoint.sh"]
